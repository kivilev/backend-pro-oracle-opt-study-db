# sshd стенда: работает от пользователя oracle (не root) на порту 2222, вход только под oracle.
# Пароль проверяет PAM через setuid-помощник unix_chkpwd, root для этого не нужен.
# Порт публикуется только на 127.0.0.1 (см. README), пароль учебный и публичный.
Port 2222
HostKey /opt/oracle/oradata/.stand/ssh/ssh_host_ed25519_key
PidFile /tmp/sshd.pid
UsePAM yes
PasswordAuthentication yes
PubkeyAuthentication yes
PermitRootLogin no
AllowUsers oracle
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
PrintMotd no
Subsystem sftp internal-sftp
